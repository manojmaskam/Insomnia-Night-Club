# ============================================================
#  Insomnia Night Club — production .htaccess (Hostinger)
#  Apache / LiteSpeed compatible. All blocks are guarded so a
#  missing module can never cause a 500 error.
# ============================================================

DirectoryIndex index.html
Options -Indexes

# ---- Force HTTPS ----
# Enable this block AFTER you've turned on SSL for the domain in Hostinger.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---- Correct MIME types ----
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType text/csv .csv
  AddType application/json .json
</IfModule>

# ---- Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml text/csv
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  # data + pages stay fresh so new events show immediately
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/csv               "access plus 0 seconds"
  ExpiresByType application/json       "access plus 0 seconds"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(csv|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Custom error page (optional) ----
# ErrorDocument 404 /index.html
